# ================================================================
# 旺生活 O2O 供应链中台 — 本地开发环境配置
#
# 选项A: 使用本机已有的 MySQL / Redis，只用 Docker 跑 Kafka
# 选项B: 全部使用 Docker（Docker MySQL 端口 3307，Redis 端口 6380）
# ================================================================

# ── 选项A: 本机 MySQL (默认 3306) ─────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456

# ── 选项B: Docker MySQL (端口 3307) — 取消注释以下行 ──────────
# DB_PORT=3307

# ── 选项A: 本机 Redis (默认 6379) ─────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── 选项B: Docker Redis (端口 6380) — 取消注释以下行 ─────────
# REDIS_PORT=6380

# ── Kafka (只能用 Docker，本机一般没装) ───────────────────────
# Docker Kafka 对外端口 9092
KAFKA_SERVERS=localhost:9092
# 如果 Spring Boot 也在 Docker 里运行 (--profile app):
# KAFKA_SERVERS=kafka:29092

# ── Druid 监控 ────────────────────────────────────────────────
DRUID_USER=admin
DRUID_PASS=admin123

